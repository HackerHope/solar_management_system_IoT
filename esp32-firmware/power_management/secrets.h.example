// Copy this file to secrets.h (same folder) and fill in YOUR values.
// secrets.h is git-ignored. Never commit or share it.
//
// If real credentials were ever stored in the old power_management.ino and that
// file was shared or committed, treat them as exposed: change the Wi-Fi password,
// change the device account password in Firebase Authentication, and (optionally)
// restrict/regenerate the Firebase API key in Google Cloud Console.

// ---- Wi-Fi ----
#define WIFI_SSID     "your-wifi-name"
#define WIFI_PASSWORD "your-wifi-password"

// ---- Firebase ----
// Project settings > General > Web API Key
#define API_KEY       "your-firebase-web-api-key"
// Realtime Database URL, no trailing slash, e.g. https://<project>-default-rtdb.<region>.firebasedatabase.app
#define DATABASE_URL  "https://your-project-default-rtdb.region.firebasedatabase.app"
// The ESP32's own Firebase Authentication account (NOT your personal account).
// Its UID must be listed as a "device" member of the system (see docs/security.md).
#define USER_EMAIL    "device@example.com"
#define USER_PASSWORD "a-long-random-device-password"

// ---- MQTT (optional; leave host empty to use Firebase only) ----
#define MQTT_BROKER_HOST ""
#define MQTT_BROKER_PORT 1883
#define MQTT_USER ""        // leave empty if the broker has no login
#define MQTT_PASS ""

// To encrypt MQTT, use port 8883, uncomment the next line and paste your
// broker/CA certificate (PEM) below. The app has a matching "Use TLS" switch.
// #define MQTT_USE_TLS
// const char MQTT_CA_CERT[] = R"EOF(
// -----BEGIN CERTIFICATE-----
// ...
// -----END CERTIFICATE-----
// )EOF";
